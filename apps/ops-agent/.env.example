# Postgres connection (Supabase: use the transaction pooler URL, port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opsagent_dev
# Optional: separate URL for migrations (Supabase: session pooler, port 5432)
MIGRATION_DATABASE_URL=
# Public base URL of this deployment (used for Telegram webhooks and CSRF origin checks)
APP_URL=http://localhost:3000
# 32 random bytes, base64: `openssl rand -base64 32`
ENCRYPTION_KEY=
# Bearer secret for /api/cron/* endpoints: `openssl rand -hex 24`
CRON_SECRET=
# rules (built-in, no key) | anthropic | openai
LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=info
SIGNUP_ENABLED=true
DB_POOL_MAX=5
